{
  "name": "propt-mcp",
  "version": "0.1.0",
  "description": "MCP server for managing prompt templates with Propt service",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "propt-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:server": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "node dist/server.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "claude",
    "prompt",
    "template",
    "ai",
    "anthropic"
  ],
  "author": "Goeun Hwang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HwangGoeun/propt-backend.git",
    "directory": "mcp"
  },
  "homepage": "https://www.propt.site",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "keytar": "^7.9.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
